# ==========================================================
# ULTRA CHECKER v21 FINAL
# Evidence Based Analyzer
# ==========================================================

$Host.UI.RawUI.WindowTitle = "Ultra Checker v21 FINAL"
Clear-Host

function Write-C($Text,$Color="White"){
    Write-Host $Text -ForegroundColor $Color
}

function Header {
Write-C @"
╔══════════════════════════════════════════════╗
║             ULTRA CHECKER v21                ║
║       Evidence Based Detection Engine        ║
╚══════════════════════════════════════════════╝
"@ Cyan
}

Header

$Results = New-Object System.Collections.ArrayList

$Stats = @{
    Files = 0
    Processes = 0
    Rules = 0
}

$Rules = @(
    @{Name="Horion"; Keys=@("horion","horioninjector"); Risk=90},
    @{Name="Vape"; Keys=@("vape","vapeclient"); Risk=95},
    @{Name="LiquidBounce"; Keys=@("liquidbounce"); Risk=80},
    @{Name="Rise Client"; Keys=@("riseclient"); Risk=85},
    @{Name="Injector"; Keys=@("injector","mapper","loader"); Risk=55},
    @{Name="Ghost Client"; Keys=@("ghostclient"); Risk=75}
)

$Whitelist = @(
    "Microsoft",
    "Windows",
    "NVIDIA",
    "AMD",
    "Intel",
    "Java",
    "Steam"
)

function Is-White($Path){
    foreach($x in $Whitelist){
        if($Path -match $x){ return $true }
    }
    return $false
}

function Add-Result($Name,$Path,$Risk,$Evidence){

    if(Is-White $Path){ return }

    $level="LOW"

    if($Risk -ge 90){$level="CRITICAL"}
    elseif($Risk -ge 70){$level="HIGH"}
    elseif($Risk -ge 40){$level="MEDIUM"}

    [void]$Results.Add([PSCustomObject]@{
        Name=$Name
        Level=$level
        Risk=$Risk
        Path=$Path
        Evidence=$Evidence
    })
}


function Analyze-File($File){

    $Stats.Files++

    foreach($Rule in $Rules){

        foreach($Key in $Rule.Keys){

            if($File.Name.ToLower() -like "*$Key*"){

                $Risk=$Rule.Risk
                $Evidence=@("Signature: $Key")

                if($File.FullName -match "AppData|Temp|Downloads"){
                    $Risk+=10
                    $Evidence+="Suspicious location"
                }

                if($File.Extension -in ".exe",".dll",".jar"){
                    $Risk+=5
                    $Evidence+="Executable type"
                }

                Add-Result `
                $Rule.Name `
                $File.FullName `
                $Risk `
                ($Evidence -join " | ")
            }
        }
    }
}


Write-C "[1/6] File scan started" Green

$ScanPaths=@(
"$env:APPDATA",
"$env:LOCALAPPDATA",
"$env:USERPROFILE\Downloads",
"$env:USERPROFILE\Desktop",
"$env:USERPROFILE\.minecraft"
)

foreach($Path in $ScanPaths){

    if(Test-Path $Path){

        Write-C "[SCAN] $Path" Yellow

        Get-ChildItem $Path -File -Recurse -ErrorAction SilentlyContinue |
        Where-Object {$_.Extension -match "\.(exe|dll|jar)$"} |
        ForEach-Object {
            Analyze-File $_
        }
    }
}


Write-C "[2/6] Process scan started" Green

Get-Process -ErrorAction SilentlyContinue | ForEach-Object {

    $Stats.Processes++

    try{

        if($_.Path){

            foreach($Rule in $Rules){

                foreach($Key in $Rule.Keys){

                    if($_.Path.ToLower() -like "*$Key*"){

                        Add-Result `
                        $Rule.Name `
                        $_.Path `
                        $Rule.Risk `
                        "Running process match"
                    }
                }
            }
        }

    }catch{}

}


Write-C "[3/6] Startup registry scan" Green

$Registry=@(
"HKCU:\Software\Microsoft\Windows\CurrentVersion\Run",
"HKLM:\Software\Microsoft\Windows\CurrentVersion\Run"
)

foreach($Reg in $Registry){

    if(Test-Path $Reg){

        $Data=(Get-ItemProperty $Reg -ErrorAction SilentlyContinue | Out-String)

        foreach($Rule in $Rules){

            foreach($Key in $Rule.Keys){

                if($Data.ToLower() -match $Key){

                    Add-Result `
                    $Rule.Name `
                    $Reg `
                    $Rule.Risk `
                    "Startup registry evidence"
                }
            }
        }
    }
}


Write-C "[4/6] Creating report" Green

$Report="$env:USERPROFILE\Desktop\UltraChecker_Report.json"

$Results | ConvertTo-Json -Depth 5 |
Out-File $Report -Encoding UTF8


Write-C ""
Write-C "================ RESULTS ================" Cyan

Write-C "Files checked: $($Stats.Files)" Green
Write-C "Processes checked: $($Stats.Processes)" Green
Write-C "Threat indicators: $($Results.Count)" Yellow


foreach($Item in ($Results | Sort-Object Risk -Descending)){

    Write-C ""
    Write-C "[$($Item.Level)] $($Item.Name)" Red
    Write-C "Risk: $($Item.Risk)/100" Yellow
    Write-C "Path: $($Item.Path)"
    Write-C "Evidence: $($Item.Evidence)" Gray
}


Write-C ""
Write-C "Report saved:"
Write-C $Report Green

Write-C ""
Write-C "Scan finished." Cyan

pause
