# ==========================================
# ULTRA CHECKER v20 FINAL
# Evidence Based Cheat Analyzer
# ==========================================

$Host.UI.RawUI.WindowTitle = "UltraChecker v20 FINAL"
Clear-Host

function C($t,$c="White"){Write-Host $t -ForegroundColor $c}

C @"
╔══════════════════════════════════════════════╗
║             ULTRA CHECKER v20 FINAL          ║
║          Advanced Evidence Analyzer          ║
╚══════════════════════════════════════════════╝
"@ Cyan

$Findings=@()
$Stats=[ordered]@{
 Files=0
 Processes=0
 Checks=0
}

$Rules=@(
 @{N="Horion";K=@("horion","horioninjector");R=90},
 @{N="Vape";K=@("vapeclient","vape");R=95},
 @{N="LiquidBounce";K=@("liquidbounce");R=80},
 @{N="Rise Client";K=@("riseclient");R=85},
 @{N="Injector";K=@("injector","mapper","loader");R=55}
)

$White=@(
"Microsoft",
"Windows",
"NVIDIA",
"AMD",
"Intel",
"Java",
"Steam",
"Mozilla"
)

function Ignore($p){
 foreach($w in $White){
  if($p -match $w){return $true}
 }
 return $false
}

function Add-Finding($name,$path,$risk,$why){
 if(Ignore $path){return}

 $level="LOW"
 if($risk -ge 90){$level="CRITICAL"}
 elseif($risk -ge 70){$level="HIGH"}
 elseif($risk -ge 40){$level="MEDIUM"}

 $script:Findings += [PSCustomObject]@{
  Name=$name
  Risk=$risk
  Level=$level
  Path=$path
  Evidence=$why
 }
}

function Analyze($file){

 $Stats.Files++

 foreach($r in $Rules){
  foreach($k in $r.K){

   if($file.Name.ToLower() -like "*$k*"){

    $risk=$r.R
    $e=@("Signature match: $k")

    if($file.FullName -match "AppData|Temp|Downloads"){
     $risk+=10
     $e+="Suspicious location"
    }

    if($file.Extension -in ".exe",".dll",".jar"){
     $risk+=5
     $e+="Executable type"
    }

    Add-Finding $r.N $file.FullName $risk ($e -join " | ")
   }
  }
 }
}

$paths=@(
"$env:APPDATA",
"$env:LOCALAPPDATA",
"$env:USERPROFILE\Downloads",
"$env:USERPROFILE\Desktop",
"$env:USERPROFILE\.minecraft",
"C:\ProgramData"
)

C "[1/5] File scanner started" Green

foreach($p in $paths){
 if(Test-Path $p){
  C "[SCAN] $p" Cyan

  Get-ChildItem $p -File -Recurse -ErrorAction SilentlyContinue |
  Where-Object {$_.Extension -in ".exe",".dll",".jar"} |
  ForEach-Object {Analyze $_}
 }
}

C "[2/5] Process scanner started" Green

Get-Process -ErrorAction SilentlyContinue | ForEach-Object {
 $Stats.Processes++

 try{
  if($_.Path){
   foreach($r in $Rules){
    foreach($k in $r.K){
     if($_.Path.ToLower() -like "*$k*"){
      Add-Finding $r.N $_.Path $r.R "Running process match"
     }
    }
   }
  }
 }catch{}
}


C "[3/5] Registry startup check" Green

$reg=@(
"HKCU:\Software\Microsoft\Windows\CurrentVersion\Run",
"HKLM:\Software\Microsoft\Windows\CurrentVersion\Run"
)

foreach($r in $reg){
 if(Test-Path $r){
  Get-ItemProperty $r -ErrorAction SilentlyContinue | Out-String |
  ForEach-Object {
   foreach($rule in $Rules){
    foreach($k in $rule.K){
     if($_ -match $k){
      Add-Finding $rule.N $r $rule.R "Startup registry match"
     }
    }
   }
  }
 }
}

C "[4/5] Creating report" Green

$report="$env:USERPROFILE\Desktop\UltraChecker_Report.json"
$Findings | ConvertTo-Json -Depth 5 | Out-File $report -Encoding UTF8

C ""
C "================ RESULT ================" Cyan
C "Files scanned: $($Stats.Files)" Green
C "Processes: $($Stats.Processes)" Green
C "Detections: $($Findings.Count)" Yellow
C "Report: $report" Green

foreach($f in $Findings){
 C ""
 C "[$($f.Level)] $($f.Name)" Red
 C "Risk: $($f.Risk)/100" Yellow
 C "Path: $($f.Path)"
 C "Evidence: $($f.Evidence)" Gray
}

C ""
C "Scan finished." Cyan
pause
