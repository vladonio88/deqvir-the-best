# ==========================================
# ULTRA CHECKER v20
# Evidence Based Detection Engine
# ==========================================

$Host.UI.RawUI.WindowTitle = "UltraChecker v20"

Clear-Host

function Write-C($t,$c="White"){ Write-Host $t -ForegroundColor $c }

function Banner {
Write-Host @"
╔══════════════════════════════════════════╗
║          ULTRA CHECKER v20               ║
║      Evidence Based Analyzer              ║
╚══════════════════════════════════════════╝
"@ -ForegroundColor Cyan
}

Banner

$Results = @()
$Stats = @{
    Files=0
    Processes=0
}

$Rules = @(
    @{Name="Horion"; Words=@("horion","horioninjector"); Risk=85},
    @{Name="Vape"; Words=@("vape","vapeclient"); Risk=90},
    @{Name="LiquidBounce"; Words=@("liquidbounce"); Risk=75},
    @{Name="Rise Client"; Words=@("riseclient"); Risk=80},
    @{Name="Injector"; Words=@("injector","loader","mapper"); Risk=45}
)

$Ignore = @(
    "Microsoft",
    "Windows",
    "NVIDIA",
    "AMD",
    "Intel"
)

function Is-Ignore($Path){
    foreach($x in $Ignore){
        if($Path -match $x){return $true}
    }
    return $false
}

function Add-Finding($Name,$Path,$Score,$Info){
    if(Is-Ignore $Path){return}

    $level="LOW"
    if($Score -ge 90){$level="CRITICAL"}
    elseif($Score -ge 70){$level="HIGH"}
    elseif($Score -ge 40){$level="MEDIUM"}

    $script:Results += [PSCustomObject]@{
        Name=$Name
        Path=$Path
        Risk=$Score
        Level=$level
        Evidence=$Info
    }
}

function Scan-File($File){

    $Stats.Files++

    $name=$File.Name.ToLower()

    foreach($rule in $Rules){
        foreach($word in $rule.Words){

            if($name -like "*$word*"){

                $score=$rule.Risk
                $ev=@("Name match: $word")

                if($File.FullName -match "AppData|Temp|Downloads"){
                    $score+=10
                    $ev+="Suspicious location"
                }

                if($File.Extension -in ".exe",".dll",".jar"){
                    $score+=5
                    $ev+="Executable file"
                }

                Add-Finding $rule.Name $File.FullName $score ($ev -join "; ")
            }
        }
    }
}

Write-C "[+] Starting scan..." Green

$Folders=@(
"$env:USERPROFILE\Desktop",
"$env:USERPROFILE\Downloads",
"$env:APPDATA",
"$env:LOCALAPPDATA",
"C:\ProgramData"
)

foreach($folder in $Folders){

    if(Test-Path $folder){

        Write-C "[SCAN] $folder" Cyan

        Get-ChildItem $folder -File -Recurse -ErrorAction SilentlyContinue |
        Where-Object {
            $_.Extension -in ".exe",".dll",".jar"
        } |
        ForEach-Object {
            Scan-File $_
        }
    }
}

Write-C ""
Write-C "Checking processes..." Cyan

Get-Process -ErrorAction SilentlyContinue | ForEach-Object {

    $Stats.Processes++

    if($_.Path){

        foreach($rule in $Rules){

            foreach($word in $rule.Words){

                if($_.Path.ToLower() -like "*$word*"){

                    Add-Finding `
                    $rule.Name `
                    $_.Path `
                    $rule.Risk `
                    "Running process match"

                }
            }
        }
    }
}


Write-Host ""
Write-C "============== RESULT ==============" Cyan

Write-C "Files scanned: $($Stats.Files)" Green
Write-C "Processes checked: $($Stats.Processes)" Green
Write-C "Findings: $($Results.Count)" Yellow


if($Results.Count -eq 0){

    Write-C ""
    Write-C "No suspicious indicators found." Green

}
else{

    foreach($r in $Results){

        Write-Host ""
        Write-C "[$($r.Level)] $($r.Name)" Red
        Write-C "Risk: $($r.Risk)/100" Yellow
        Write-C "Path: $($r.Path)" White
        Write-C "Evidence: $($r.Evidence)" Gray
    }
}

$Results | ConvertTo-Json | Out-File "$env:USERPROFILE\Desktop\UltraChecker_Report.json"

Write-C ""
Write-C "Report saved to Desktop." Green
Write-C "Finished." Cyan

Read-Host "Press Enter to exit"
