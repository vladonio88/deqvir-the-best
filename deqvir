# ==========================
# WHITELIST
# ==========================

$Whitelist=@(
    "Windows",
    "Microsoft",
    "NVIDIA",
    "AMD",
    "Intel",
    "Java",
    "Minecraft Launcher"
)


function Is-Whitelisted($text){

foreach($item in $Whitelist){

    if($text -like "*$item*"){
        return $true
    }

}

return $false

}



# ==========================
# RISK ENGINE
# ==========================


function Add-Finding {


param(
[string]$Name,
[string]$Path,
[int]$Score,
[string[]]$Evidence
)


if(Is-Whitelisted $Path){
    return
}


$level="LOW"


if($Score -ge 90){
    $level="CRITICAL"
}
elseif($Score -ge 70){
    $level="HIGH"
}
elseif($Score -ge 40){
    $level="MEDIUM"
}


$Global:Results += [PSCustomObject]@{

Name=$Name
Path=$Path
Risk=$Score
Level=$level
Evidence=$Evidence -join ", "

}


}


# ==========================
# SIGNATURE CHECK
# ==========================


function Check-Signature {


param(
[string]$Path
)


$name =
[System.IO.Path]::GetFileName($Path).ToLower()


foreach($sig in $Signatures){


foreach($word in $sig.Keywords){


if($name -like "*$word*"){


$score=$sig.Risk


$evidence=@(
"Keyword match: $word"
)


# location bonus

if($Path -match "AppData|Temp|Downloads"){
    $score+=10
    $evidence+="Suspicious location"
}


Add-Finding `
$sig.Name `
$Path `
$score `
$evidence


}


}


}


}



Write-Color ""
