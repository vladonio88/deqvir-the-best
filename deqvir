# UltraChecker v22.1 FIXED

$Host.UI.RawUI.WindowTitle="UltraChecker v22.1"
Clear-Host

function W($t,$c="White"){ Write-Host $t -ForegroundColor $c }

W @"
╔══════════════════════════════════════╗
║        ULTRA CHECKER v22.1           ║
║      Fixed Detection Engine          ║
╚══════════════════════════════════════╝
"@ Cyan

$Results = New-Object System.Collections.ArrayList
$FilesChecked = 0
$ProcessesChecked = 0

$BadNames = @(
    "fateinjector",
    "injector",
    "cheat",
    "hack",
    "ghostclient",
    "vape",
    "horion",
    "clientinject",
    "aimassist",
    "killaura"
)

$SafePaths = @(
    "fabric-loader",
    "fabric-resource-loader",
    "processedmods",
    "prismlauncher",
    "modrinthapp",
    "labymod",
    "forge",
    "neoforge",
    "\libraries\",
    "\versions\"
)

function IsSafe($Path){
    foreach($s in $SafePaths){
        if($Path.ToLower().Contains($s.ToLower())){
            return $true
        }
    }
    return $false
}

function Add-Finding($Name,$Path,$Risk,$Evidence){
    [void]$Results.Add([PSCustomObject]@{
        Name=$Name
        Risk=$Risk
        Path=$Path
        Evidence=$Evidence
    })
}

function Check-File($File){

    $script:FilesChecked++

    if(IsSafe $File.FullName){
        return
    }

    foreach($bad in $BadNames){

        if($File.Name.ToLower().Contains($bad)){

            $risk=70
            $ev=@("Suspicious name: $bad")

            if($File.FullName -match "Downloads|Temp|AppData"){
                $risk+=10
                $ev+="Suspicious location"
            }

            try{
                $sig=Get-AuthenticodeSignature $File.FullName

                if($sig.Status -ne "Valid"){
                    $risk+=10
                    $ev+="Unsigned file"
                }

            }catch{}

            Add-Finding `
            $File.Name `
            $File.FullName `
            $risk `
            ($ev -join " | ")
        }
    }
}


W "[1/3] File scan..." Green

$Scan=@(
"$env:USERPROFILE\Downloads",
"$env:USERPROFILE\Desktop",
"$env:APPDATA",
"$env:LOCALAPPDATA"
)

foreach($path in $Scan){

    if(Test-Path $path){

        W "Scanning $path" Yellow

        Get-ChildItem $path -Recurse -File -ErrorAction SilentlyContinue |
        Where-Object {
            $_.Extension -in ".exe",".dll",".jar"
        } |
        ForEach-Object {
            Check-File $_
        }
    }
}


W "[2/3] Process scan..." Green

Get-Process -ErrorAction SilentlyContinue | ForEach-Object {

    $script:ProcessesChecked++

    try{

        if($_.Path){

            foreach($bad in $BadNames){

                if($_.Path.ToLower().Contains($bad)){

                    Add-Finding `
                    $_.ProcessName `
                    $_.Path `
                    90 `
                    "Suspicious running process"

                }
            }
        }

    }catch{}
}


W "[3/3] Report..." Green

$Report="$env:USERPROFILE\Desktop\UltraChecker_v22.1_Report.json"

$Results |
ConvertTo-Json -Depth 5 |
Out-File $Report -Encoding UTF8


W ""
W "=============== RESULT ===============" Cyan
W "Files checked: $FilesChecked" Green
W "Processes checked: $ProcessesChecked" Green
W "Detections: $($Results.Count)" Yellow


foreach($r in ($Results | Sort-Object Risk -Descending)){

    W ""
    W "[RISK $($r.Risk)] $($r.Name)" Red
    W "Path: $($r.Path)"
    W "Evidence: $($r.Evidence)" Gray
}


W ""
W "Report:"
W $Report Green

pause
