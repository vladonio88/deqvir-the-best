# UltraChecker v22 - Fixed False Positives

$Host.UI.RawUI.WindowTitle="UltraChecker v22"
Clear-Host

function W($t,$c="White"){Write-Host $t -ForegroundColor $c}

W @"
╔══════════════════════════════════════╗
║          ULTRA CHECKER v22           ║
║       False Positive Fixed           ║
╚══════════════════════════════════════╝
"@ Cyan

$Results=@()

$BadNames=@(
"fateinjector",
"injector",
"cheat",
"hacks",
"ghostclient",
"vape",
"horion",
"clientinject"
)

$SafePaths=@(
"fabric-loader",
"fabric-resource-loader",
"processedmods",
"prismlauncher",
"modrinthapp",
"labymod",
"forge",
"neoforge",
"libraries",
"minecraft"
)

function IsSafe($p){
 foreach($s in $SafePaths){
  if($p.ToLower() -like "*$s*"){return $true}
 }
 return $false
}

function CheckFile($f){

 if(IsSafe $f.FullName){return}

 foreach($b in $BadNames){

  if($f.Name.ToLower() -like "*$b*"){

   $risk=80
   $ev=@("Suspicious name: $b")

   if($f.FullName -match "Downloads|Temp|AppData"){
    $risk+=10
    $ev+="Suspicious location"
   }

   $sig=Get-AuthenticodeSignature $f.FullName -ErrorAction SilentlyContinue

   if($sig.Status -ne "Valid"){
    $risk+=10
    $ev+="Unsigned"
   }

   $Results += [PSCustomObject]@{
    Name=$f.Name
    Risk=$risk
    Path=$f.FullName
    Evidence=$ev -join " | "
   }
  }
 }
}

W "[1] Scanning files..." Green

$paths=@(
"$env:USERPROFILE\Downloads",
"$env:USERPROFILE\Desktop",
"$env:APPDATA",
"$env:LOCALAPPDATA"
)

foreach($p in $paths){
 if(Test-Path $p){
  Get-ChildItem $p -Recurse -File -ErrorAction SilentlyContinue |
  Where-Object {$_.Extension -in ".exe",".dll",".jar"} |
  ForEach-Object {CheckFile $_}
 }
}

W ""
W "============== RESULT ==============" Cyan

if($Results.Count -eq 0){
 W "No suspicious files found." Green
}
else{
 foreach($r in $Results){
  W ""
  W "[HIGH] $($r.Name)" Red
  W "Risk: $($r.Risk)/100" Yellow
  W "Path: $($r.Path)"
  W "Evidence: $($r.Evidence)"
 }
}

$Results | ConvertTo-Json -Depth 5 |
Out-File "$env:USERPROFILE\Desktop\UltraChecker_v22_Report.json"

W ""
W "Report saved on Desktop" Green
pause
